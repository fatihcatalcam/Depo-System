# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# gecici iskele klasoru
/scaffold-tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Veritabani yedekleri. Icinde musteri adi, telefon ve adres var; depoya
# asla girmemeli.
/backups

.env*

# Ornek env dosyasi depoda kalmali. Bu istisna TUM .env* kurallarindan
# sonra gelmeli, yoksa gecersiz kalir: Vercel CLI her calistiginda dosyanin
# sonuna bir .env* satiri daha ekliyor, bu yuzden istisna en altta duruyor.
!.env.example
