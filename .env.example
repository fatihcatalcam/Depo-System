# Neon Postgres baglanti adresi (Vercel Storage > Neon > .env.local sekmesinden alinir)
DATABASE_URL=postgres://kullanici:parola@host/veritabani?sslmode=require

# Oturum cerezini imzalayan gizli anahtar. En az 32 karakter olmali.
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=en-az-otuz-iki-karakterlik-rastgele-bir-dizi-buraya

# Sistem ilk acildiginda olusturulacak ortak parola.
# Giris yaptiktan sonra Ayarlar ekranindan degistirilebilir.
INITIAL_APP_PASSWORD=depo2026
